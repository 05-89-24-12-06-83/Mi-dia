:root{--bg:#f4f7f5;--card:#fff;--surface:#f8faf9;--ink:#12202b;--muted:#6b7280;--green:#16a34a;--green2:#22c55e;--line:#e5e7eb;--soft:#eaf8ef;--task:#eefbf2;--shadow:0 14px 40px rgba(15,23,42,.08)}
:root[data-theme="dark"]{--bg:#081018;--card:#101923;--surface:#16212c;--ink:#f2f6f8;--muted:#a8b3bd;--line:#263340;--soft:#102a1c;--task:#11271b;--shadow:0 16px 44px rgba(0,0,0,.34);color-scheme:dark}
@media(prefers-color-scheme:dark){:root[data-theme="system"]{--bg:#081018;--card:#101923;--surface:#16212c;--ink:#f2f6f8;--muted:#a8b3bd;--line:#263340;--soft:#102a1c;--task:#11271b;--shadow:0 16px 44px rgba(0,0,0,.34);color-scheme:dark}}
*{box-sizing:border-box}body{margin:0;font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;background:var(--bg);color:var(--ink);transition:background .2s,color .2s}button,input,select,textarea{font:inherit;color:inherit}.shell{min-height:100vh}.topbar{height:74px;background:var(--card);border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;padding:0 4vw;position:sticky;top:0;z-index:10}.brand{display:flex;gap:12px;align-items:center}.brand strong{display:block;font-size:1.2rem}.brand span{display:block;font-size:.75rem;color:var(--muted)}.logo{width:46px;height:46px}.layout{display:grid;grid-template-columns:230px 1fr;gap:22px;max-width:1440px;margin:auto;padding:22px}.card{background:var(--card);border:1px solid var(--line);border-radius:22px;box-shadow:var(--shadow)}.sidebar{padding:14px;height:max-content;position:sticky;top:96px}.nav{display:block;width:100%;border:0;background:transparent;text-align:left;padding:13px 14px;border-radius:14px;margin:3px 0;cursor:pointer;color:var(--ink)}.nav.active,.nav:hover{background:var(--soft);color:#20b85a}.mini-card{margin-top:18px;padding:14px;border-radius:14px;background:var(--surface)}.mini-card span,.settings-card label{font-size:.78rem;color:var(--muted)}.mini-card strong{display:block;margin-top:4px}.settings-card select{width:100%;margin-top:8px;border:1px solid var(--line);background:var(--card);border-radius:10px;padding:9px}.content{min-width:0}.hero{padding:24px;display:flex;align-items:center;justify-content:space-between;gap:18px}.eyebrow{font-size:.72rem;font-weight:800;letter-spacing:.12em;color:var(--green)}h1{font-size:clamp(1.8rem,4vw,3rem);margin:.18em 0}h2{margin:0;font-size:1.05rem}.hero p{color:var(--muted);margin:0}.primary,.ghost{border:0;border-radius:14px;padding:12px 17px;font-weight:750;cursor:pointer}.primary{background:linear-gradient(135deg,var(--green),var(--green2));color:#fff;box-shadow:0 8px 20px rgba(22,163,74,.22)}.primary:active,.nav:active,.ghost:active{transform:scale(.98);filter:brightness(1.12)}.ghost{background:var(--surface);color:var(--ink)}.grid{display:grid;grid-template-columns:minmax(0,1.7fr) minmax(280px,.8fr);gap:22px;margin-top:22px}.timeline-card,.next-card{padding:18px}.section-head{display:flex;justify-content:space-between;align-items:center;gap:10px;margin-bottom:16px}.section-head select{border:1px solid var(--line);background:var(--card);border-radius:10px;padding:8px}.timeline{min-height:420px}.empty{color:var(--muted);padding:42px 12px;text-align:center;border:1px dashed var(--line);border-radius:16px}.task-item{display:grid;grid-template-columns:60px 1fr 38px 38px;align-items:center;gap:8px;padding:10px 0;border-bottom:1px solid var(--line)}.task-time{font-size:.82rem;color:var(--muted);font-variant-numeric:tabular-nums}.task-main{border-left:5px solid var(--green);padding:9px 12px;background:var(--task);border-radius:9px}.task-main strong,.task-main span{display:block}.task-main span{font-size:.78rem;color:var(--muted);margin-top:2px}.done-btn,.more-btn,.icon-btn{border:0;border-radius:10px;background:var(--surface);color:var(--ink);cursor:pointer;height:34px}.done-btn{color:var(--green);font-weight:900}.more-btn{font-size:.72rem}.task-item.done{opacity:.5}.task-item.done strong{text-decoration:line-through}.badge{background:var(--soft);color:#20b85a;padding:5px 9px;border-radius:99px;font-size:.78rem}.next-list{display:grid;gap:9px}.next-row{padding:12px;border:1px solid var(--line);border-radius:13px}.next-row strong,.next-row span{display:block}.next-row span{font-size:.78rem;color:var(--muted);margin-top:3px}dialog{border:1px solid var(--line);padding:0;border-radius:24px;width:min(620px,94vw);background:var(--card);color:var(--ink);box-shadow:0 24px 80px rgba(0,0,0,.25)}dialog::backdrop{background:rgba(5,10,18,.58);backdrop-filter:blur(3px)}.task-form{padding:22px}.dialog-head{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:16px}.dialog-head h2{font-size:1.4rem;margin-top:4px}.icon-btn{font-size:1.3rem;width:36px}.task-form label{display:block;font-size:.83rem;font-weight:700;margin:12px 0}.task-form input,.task-form select,.task-form textarea{width:100%;margin-top:6px;border:1px solid var(--line);border-radius:12px;padding:12px;background:var(--card);color:var(--ink)}.two{display:grid;grid-template-columns:1fr 1fr;gap:12px}.switch-row{display:flex;justify-content:space-between;align-items:center;padding:12px 0;border-top:1px solid var(--line)}.switch-row input{width:22px;height:22px;accent-color:var(--green)}.hint{font-size:.78rem;color:var(--muted)}.actions{display:flex;justify-content:flex-end;gap:10px;margin-top:16px}.weekday-picker{border:1px solid var(--line);border-radius:14px;padding:12px;margin:10px 0}.weekday-picker legend{padding:0 6px;font-size:.82rem;font-weight:800}.weekday-grid{display:grid;grid-template-columns:repeat(7,1fr);gap:6px}.weekday-grid label{margin:0;padding:8px 4px;border:1px solid var(--line);border-radius:10px;text-align:center;background:var(--surface);cursor:pointer;font-size:.75rem}.weekday-grid input{width:auto;margin:0 4px 0 0;accent-color:var(--green)}.top-actions{display:flex;gap:10px;align-items:center}.theme-select{border:1px solid var(--line);background:var(--card);color:var(--ink);border-radius:12px;padding:8px 10px;max-width:120px}.status-pill{font-size:.74rem;padding:7px 10px;border-radius:999px;background:var(--surface);color:var(--muted);border:1px solid var(--line)}.status-pill.good{background:var(--soft);color:#20b85a}.status-pill.bad{background:#34151d;color:#ff8ca1;border-color:#5b2430}.alarm-dialog{width:min(420px,92vw);background:transparent;border:0;box-shadow:none}.alarm-panel{background:var(--card);border:1px solid var(--line);border-radius:28px;padding:28px;text-align:center;box-shadow:0 30px 90px rgba(15,23,42,.35)}.alarm-logo{width:90px;height:90px;margin-bottom:12px}.alarm-panel h2{font-size:1.7rem;margin:8px 0}.alarm-panel p{color:var(--muted);margin:0 0 12px}.alarm-state{font-size:.82rem;color:var(--muted);margin-bottom:20px}.alarm-actions{display:grid;grid-template-columns:1fr 1fr;gap:10px}@media(max-width:900px){.layout{grid-template-columns:1fr;padding:14px}.sidebar{display:none}.grid{grid-template-columns:1fr}.topbar{padding:0 16px}.hero{padding:18px}.next-card{order:2}}@media(max-width:560px){.topbar{height:66px}.theme-select{max-width:84px;padding:7px 6px;font-size:.75rem}.brand span{display:none}.logo{width:40px;height:40px}.hero{align-items:flex-start;flex-direction:column}.hero .primary{width:100%}.two{grid-template-columns:1fr}.timeline-card,.next-card{padding:14px;border-radius:18px}.task-item{grid-template-columns:52px 1fr 34px 34px}.section-head{align-items:flex-start;flex-direction:column}.section-head select{width:100%}.actions button{flex:1}.weekday-grid{grid-template-columns:repeat(4,1fr)}.status-pill{display:none}.alarm-actions{grid-template-columns:1fr}.top-actions{gap:6px}}@media(display-mode:standalone){.topbar{padding-top:env(safe-area-inset-top);height:calc(66px + env(safe-area-inset-top))}}
