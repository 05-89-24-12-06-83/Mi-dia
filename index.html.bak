<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="theme-color" content="#16a34a" />
  <meta name="description" content="Mi Día: agenda sencilla con alarmas y recordatorios." />
  <link rel="manifest" href="manifest.webmanifest" />
  <link rel="icon" href="icons/icon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="icons/icon-192.png" />
  <link rel="stylesheet" href="styles.css" />
  <title>Mi Día</title>
</head>
<body>
  <div class="shell">
    <header class="topbar">
      <div class="brand">
        <img src="icons/icon.svg" alt="Mi Día" class="logo" />
        <div><strong>Mi Día</strong><span>Planifica · Organiza · Logra</span></div>
      </div>
      <div class="top-actions"><select id="themeMode" class="theme-select" aria-label="Apariencia"><option value="system">Sistema</option><option value="light">Claro</option><option value="dark">Oscuro</option></select><span id="notifStatus" class="status-pill">Avisos: sin activar</span><button id="installBtn" class="ghost" hidden>Instalar app</button></div>
    </header>

    <main class="layout">
      <aside class="sidebar card">
        <button class="nav active">✓ Hoy</button>
        <button class="nav" id="goNew">＋ Nueva función</button>
        <button class="nav" id="requestNotifications">🔔 Activar avisos</button>
        <div class="mini-card">
          <span>Próximos 6 meses</span>
          <strong id="futureCount">0 funciones</strong>
        </div>
      </aside>

      <section class="content">
        <div class="hero card">
          <div>
            <span class="eyebrow">ORGANIZA TU DÍA</span>
            <h1 id="todayTitle">Hoy</h1>
            <p>Captura una función, define la hora y deja que Mi Día te la recuerde.</p>
          </div>
          <button id="newBtn" class="primary">＋ Nueva función</button>
        </div>

        <div class="grid">
          <section class="card timeline-card">
            <div class="section-head">
              <h2>Agenda de hoy</h2>
              <select id="viewStep" aria-label="Intervalo de agenda">
                <option value="1">Minuto a minuto</option>
                <option value="15" selected>Cada 15 minutos</option>
              </select>
            </div>
            <div id="timeline" class="timeline"></div>
          </section>

          <section class="card next-card">
            <div class="section-head"><h2>Próximos</h2><span id="nextBadge" class="badge">0</span></div>
            <div id="nextList" class="next-list"></div>
          </section>
        </div>
      </section>
    </main>
  </div>

  <dialog id="taskDialog">
    <form id="taskForm" method="dialog" class="task-form">
      <div class="dialog-head">
        <div><span class="eyebrow">NUEVA FUNCIÓN</span><h2>Programa tu recordatorio</h2></div>
        <button type="button" id="closeDialog" class="icon-btn">×</button>
      </div>
      <label>Título o función<input id="title" required maxlength="80" placeholder="Ej. Llamar al proveedor" /></label>
      <div class="two">
        <label>Fecha<input id="date" type="date" required /></label>
        <label>Hora<input id="time" type="time" required step="60" /></label>
      </div>
      <div class="two">
        <label>Captura de tiempo<select id="step"><option value="1">Minuto a minuto</option><option value="15" selected>Intervalos de 15 min</option></select></label>
        <label>Recordar cada
          <select id="repeat">
            <option value="none">Solo una vez</option>
            <option value="5m">Cada 5 minutos</option>
            <option value="daily">Diario</option>
            <option value="weekdays">Días específicos de la semana</option>
          </select>
        </label>
      </div>
      <fieldset id="weekdayPicker" class="weekday-picker" hidden>
        <legend>Selecciona los días que quieres que suene</legend>
        <div class="weekday-grid">
          <label><input type="checkbox" value="1">Lun</label>
          <label><input type="checkbox" value="2">Mar</label>
          <label><input type="checkbox" value="3">Mié</label>
          <label><input type="checkbox" value="4">Jue</label>
          <label><input type="checkbox" value="5">Vie</label>
          <label><input type="checkbox" value="6">Sáb</label>
          <label><input type="checkbox" value="0">Dom</label>
        </div>
      </fieldset>
      <label>Nota<textarea id="notes" rows="3" placeholder="Opcional"></textarea></label>
      <div class="switch-row"><span>Alarma / notificación</span><input id="alarm" type="checkbox" checked /></div>
      <div class="switch-row"><span>Sonido en este evento</span><input id="sound" type="checkbox" checked /></div>
      <p class="hint">Los recordatorios recurrentes se programan hasta 6 meses desde su creación.</p>
      <div class="actions"><button type="button" id="cancelBtn" class="ghost">Cancelar</button><button type="submit" class="primary">Guardar</button></div>
    </form>
  </dialog>

  <dialog id="alarmDialog" class="alarm-dialog">
    <div class="alarm-panel">
      <img src="icons/icon.svg" alt="Mi Día" class="alarm-logo" />
      <span class="eyebrow">RECORDATORIO</span>
      <h2 id="alarmTitle">Es hora</h2>
      <p id="alarmNote">Tienes una función programada.</p>
      <div id="alarmSoundState" class="alarm-state">🔊 Con sonido</div>
      <div class="alarm-actions">
        <button id="alarmDone" class="primary" type="button">✓ Completar</button>
        <button id="alarmSnooze" class="ghost" type="button">+5 min</button>
      </div>
    </div>
  </dialog>

  <template id="taskTemplate">
    <article class="task-item">
      <div class="task-time"></div>
      <div class="task-main"><strong></strong><span></span></div>
      <button class="done-btn" title="Completar">✓</button>
      <button class="more-btn" title="Posponer 5 minutos">+5</button>
    </article>
  </template>

  <script src="app.js"></script>
</body>
</html>
